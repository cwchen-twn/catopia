# Load .env.development* files when running `wrangler dev`
NEXTJS_ENV=development

# Resend email service — set your real values before running `bun run set-secrets`
RESEND_API_KEY=xxx
RESEND_FROM=XXX <noreply@xxx.xxx.xxx>
RESEND_SUBJECT_PREFIX=[xxx]
RESEND_TO=xxx@xxx.xxx

# Cloudflare Turnstile (contact form CAPTCHA). The values below are
# Cloudflare's published always-pass test keypair — safe for local dev.
# Replace with your real widget's site key/secret before deploying
# (Cloudflare dashboard -> Turnstile -> create a widget for your domain).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
