{
  "name": "catopia",
  "version": "1.0.0-rc1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "d1-migrate": "wrangler d1 migrations apply catopia-crm --remote",
    "d1-query": "wrangler d1 execute catopia-crm --remote --command",
    "d1-contacts": "wrangler d1 execute catopia-crm --remote --command \"SELECT id, name, email, subject, message, created_at FROM contact_submissions ORDER BY created_at DESC\"",
    "d1-clients": "wrangler d1 execute catopia-crm --remote --command \"SELECT id, email, status, created_at, updated_at FROM clients ORDER BY updated_at DESC\"",
    "d1-set-status": "bash scripts/mark-client-status.sh",
    "images": "bun run scripts/optimize-images.ts",
    "og-image": "bun run scripts/generate-og-image.ts",
    "new-post": "bun run scripts/new-blog-post.ts",
    "test-email": "bun --env-file=.dev.vars scripts/test-email.ts",
    "set-cf-secrets": "bash scripts/set-cf-secrets.sh",
    "set-gh-secrets": "bash scripts/set-gh-secrets.sh",
    "ncu-check": "ncu",
    "ncu-all": "ncu -u",
    "ncu-minor": "ncu --target minor -u"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.4",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.38.0",
    "marked": "^18.0.11",
    "next": "16.3.3",
    "next-intl": "^4.14.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.25.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "npm-check-updates": "^22.2.9",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "wrangler": "^4.127.1"
  }
}
